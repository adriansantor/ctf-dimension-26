server {
    listen 80;
    server_name 192.168.1.69;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name 192.168.1.69;

    root /var/www/ctf;
    index index.php;

    ssl_certificate /etc/nginx/ssl/ctf-app.crt;
    ssl_certificate_key /etc/nginx/ssl/ctf-app.key;

    location = /retos.csv {
        deny all;
    }

    location ^~ /private/ {
        deny all;
    }

    location ^~ /logs/ {
        deny all;
    }

    location = /backend.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/backend.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location = /scoreboard.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/scoreboard.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location = /landing.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/landing.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~ /index\.php$ {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~ \.php$ {
        return 404;
    }

    location / {
        try_files $uri $uri/ $uri/index.php /landing.php =404;
    }
}
